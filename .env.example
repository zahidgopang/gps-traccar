APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Obfuscate JS for production (npm run build:protect). Uses readable public/js when false.
ASSET_PROTECTION=false
# Block right-click / F12 / Ctrl+U on user & admin pages (bypassable deterrent only).
CLIENT_HARDENING=false
# Reject common crawler/download tool user-agents on /user and /admin routes.
BLOCK_SCRAPERS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Traccar shared-database migration (start Traccar once to create tc_* tables)
# TRACCAR_ENABLED=true
# TRACCAR_MODE=full
# off | dual_write (deprecated) | read_traccar | full (recommended)
# TRACCAR_SYNC_ON_CHANGE=false
# TRACCAR_WRITE_LEGACY_TABLES=false
# TRACCAR_SYNC_DEVICES_ON_CHANGE=true
# TRACCAR_SYNC_USERS_ON_CHANGE=true
# TRACCAR_PROTOCOL=laravel
# TRACCAR_SYNC_USERS=true
# TRACCAR_SYNC_USER_PASSWORD=true
# TRACCAR_DEFAULT_USER_PASSWORD=12345678
# TRACCAR_RESET_USER_PASSWORD_ON_SYNC=false
# TRACCAR_SYNC_GEOFENCES=true
# TRACCAR_SYNC_EVENTS=true
# TRACCAR_SYNC_LOG=false
# TRACCAR_DEVICE_DISABLE_WHEN=blocked
# TRACCAR_ALLOW_INACTIVE_INGEST=true

# Default admin seeded into tc_users on php artisan migrate
# ADMIN_EMAIL=admin@admin.com
# ADMIN_PASSWORD=12345678
# ADMIN_NAME=Admin

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
